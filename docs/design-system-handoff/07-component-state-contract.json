  "contract": {
    "version": "2026-06-02-as-is-component-state-contract",
    "type": "component-state-handoff-contract",
    "scope": [
      "interactive component DOM contracts",
      "state requirements for TO BE design",
      "product block locator taxonomy",
      "migration policy for visual redesign"
    ],
    "guard": {
      "script": "tools/component-state-contract-check.mjs",
      "npmScript": "design:components:check",
      "checks": [
        "required component ids exist in JSON",
        "component source files exist",
        "required selectors/attributes still exist in sources",
        "core TO BE state requirements are documented",
        "package script is registered"
      ]
    },
    "migrationPolicy": [
      "Visual restyle may change classes, spacing, colors and layout only if preservedSelectors stay available or a separate frontend migration is documented.",
      "Forms, chat, FAQ, modal, mobile menu, product blocks and price builder are behavior-bearing components and must not be redesigned from screenshots alone.",
      "New interactive states require either existing JS support or an explicit dev task with page asset, smoke and analytics implications.",
      "Design specs must separate AS IS preserved contracts from TO BE component names."
    ]
  },
