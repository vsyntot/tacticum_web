      "designDeliverables": [
        "desktop header anatomy",
        "desktop dropdown/current state",
        "mobile menu layout",
        "focus states",
        "product/commercial navigation hierarchy"
      ],
      "implementationNotes": [
        "Keep mobile menu toggle and contact modal triggers unless a JS migration is planned.",
        "Navigation hierarchy changes must keep product and money-page links visible to seo:check."
      ],
      "openDecisions": [
        "Full-screen mobile menu versus drawer.",
        "Compact sticky header state.",
        "Product versus services grouping in desktop nav."
      ]
    },
