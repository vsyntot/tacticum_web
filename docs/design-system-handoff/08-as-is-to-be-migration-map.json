{
  "meta": {
    "project": "tacticum.ru",
    "snapshotDate": "2026-06-02",
    "status": "as-is-to-be-migration-baseline",
    "dependsOn": [
      "docs/design-system-handoff/05-design-tokens-as-is.json",
      "docs/design-system-handoff/07-component-state-contract.json"
    ],
    "note": "This file maps checked AS IS component/state contracts to TO BE design-system component work. It is a planning baseline, not final approved Figma naming."
  },
  "contract": {
    "version": "2026-06-02-as-is-to-be-migration-map",
    "type": "component-migration-map",
    "guard": {
      "script": "tools/design-migration-map-check.mjs",
      "npmScript": "design:migration:check",
      "checks": [
        "all component ids from 07-component-state-contract.json are mapped",
        "migration types are allowed",
        "risk levels are allowed",
        "required gates are present for high-risk components",
        "package script is registered"
      ]
    },
    "allowedMigrationTypes": [
      "visual-restyle",
      "contract-preserving-split",
      "contract-migration",
      "new-interaction"
    ],
    "allowedRiskLevels": [
      "low",
      "medium",
      "high"
    ],
    "migrationTypeDefinitions": {
      "visual-restyle": "Change visual anatomy, CSS classes, layout, density and copy while preserving selectors/fields/JS behavior.",
      "contract-preserving-split": "Move markup into a better component/partial boundary while preserving behavior-bearing selectors.",
      "contract-migration": "Change selectors, fields, payload, JS behavior or analytics contract; requires frontend/backend scope and smoke updates.",
      "new-interaction": "Add a new interactive state/control; requires page asset decision, implementation and QA smoke."
    }
  },
  "globalRules": [
    "Every TO BE design component must reference the AS IS source component id or explicitly mark a new component as out-of-scope for this migration map.",
    "High-risk components must include Design, Frontend and QA gates.",
    "Any migration that touches form payloads, REST endpoints, analytics params or PII handling requires Security / Integration review.",
    "Visual restyle is the default migration type for first TO BE implementation unless a component's preservedSelectors cannot support the design.",
    "Do not remove product block locators, form selectors, chat selectors, FAQ classes or price builder data attributes without updating JS, smoke and docs."
  ],
  "mappings": [
    {
