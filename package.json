{
  "name": "tacticum-web",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i ./local/templates/tacticum/assets/src/tailwind.css -o ./local/templates/tacticum/tailwind.generated.css",
    "css:watch": "tailwindcss -i ./local/templates/tacticum/assets/src/tailwind.css -o ./local/templates/tacticum/tailwind.generated.css --watch",
    "css:check": "tailwindcss -i ./local/templates/tacticum/assets/src/tailwind.css -o /tmp/tacticum-tailwind.generated.css && cmp -s /tmp/tacticum-tailwind.generated.css ./local/templates/tacticum/tailwind.generated.css && grep -q '@layer theme, base, components, utilities;' ./local/templates/tacticum/tailwind.generated.css",
    "css:syntax": "node ./tools/css-syntax-check.mjs",
    "js:check": "node ./tools/js-syntax-check.mjs",
    "template-styles:check": "node ./tools/template-styles-retirement-check.mjs",
    "design:tokens:check": "node ./tools/design-token-contract-check.mjs",
    "design:components:check": "node ./tools/component-state-contract-check.mjs",
    "design:migration:check": "node ./tools/design-migration-map-check.mjs",
    "design:handoff:check": "npm run design:tokens:check && npm run design:components:check && npm run design:migration:check && node ./tools/design-handoff-check.mjs",
    "product:gaps:check": "node ./tools/product-gap-closure-check.mjs",
    "dev:preflight": "node ./tools/dev-env-preflight.mjs",
    "visual:smoke": "node ./tools/visual-smoke.mjs",
    "visual:smoke:prod": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru node ./tools/visual-smoke.mjs",
    "product:block-previews": "TACTICUM_VISUAL_PAGES=/platform/,/agents/,/dev/,/forum/ TACTICUM_EXPECT_PRODUCT_BLOCKS=1 TACTICUM_CAPTURE_PRODUCT_BLOCKS=1 node ./tools/visual-smoke.mjs",
    "product:block-previews:prod": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_VISUAL_PAGES=/platform/,/agents/,/dev/,/forum/ TACTICUM_EXPECT_PRODUCT_BLOCKS=1 TACTICUM_CAPTURE_PRODUCT_BLOCKS=1 node ./tools/visual-smoke.mjs",
    "product:source:smoke:prod": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_VISUAL_PAGES=/platform/,/agents/,/dev/,/forum/ TACTICUM_EXPECT_SEO_HEAD=1 TACTICUM_EXPECT_PRODUCT_SOURCE=bitrix node ./tools/visual-smoke.mjs",
    "product:source:http:prod": "TACTICUM_PRODUCT_SOURCE_BASE_URL=https://tacticum.ru TACTICUM_EXPECT_PRODUCT_SOURCE=bitrix node ./tools/product-source-http-check.mjs",
    "seo:check": "node ./tools/seo-check.mjs",
    "seo:check:prod": "TACTICUM_SEO_CHECK_BASE_URL=https://tacticum.ru TACTICUM_SEO_CHECK_HTTP=1 node ./tools/seo-check.mjs",
    "seo:smoke": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_EXPECT_SEO_HEAD=1 node ./tools/visual-smoke.mjs",
    "browser:smoke": "TACTICUM_VISUAL_ACTIONS=1 node ./tools/visual-smoke.mjs",
    "browser:smoke:prod": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_VISUAL_ACTIONS=1 node ./tools/visual-smoke.mjs",
    "browser:console": "TACTICUM_VISUAL_ACTIONS=1 TACTICUM_VISUAL_FAIL_ON_WARNINGS=1 node ./tools/visual-smoke.mjs",
    "browser:console:prod": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_VISUAL_ACTIONS=1 TACTICUM_VISUAL_FAIL_ON_WARNINGS=1 node ./tools/visual-smoke.mjs",
    "browser:smoke:price": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_VISUAL_PAGES=/price/ TACTICUM_VISUAL_ACTIONS=1 TACTICUM_EXPECT_PRICE_TEAM_PRESETS=1 node ./tools/visual-smoke.mjs",
    "release:smoke:prod": "npm run seo:smoke && npm run browser:console:prod && npm run browser:smoke:price",
    "release:public-precheck:prod": "TACTICUM_RELEASE_BASE_URL=https://tacticum.ru node ./tools/release-public-precheck.mjs",
    "release:product-first:prod-check": "npm run seo:check:prod && npm run seo:smoke && npm run browser:console:prod && npm run browser:smoke:price && npm run release:signoff:draft-check -- docs/workflow/release-signoff-2026-06-01-product-first.draft.json && TACTICUM_RELEASE_SIGNOFF=docs/workflow/release-signoff-2026-06-01-product-first.draft.json npm run gaps:known",
    "e2e:css-js:prod": "npm run js:check && npm run css:check && npm run css:syntax && npm run template-styles:check && npm run visual:smoke:prod && npm run browser:console:prod && npm run browser:smoke:price",
    "e2e:css-js:local": "npm run js:check && npm run css:check && npm run css:syntax && npm run template-styles:check && npm run visual:smoke:css-local && npm run browser:console:css-local",
    "release:signoff:check": "node ./tools/release-signoff-check.mjs",
    "release:signoff:draft-check": "node ./tools/release-signoff-check.mjs --allow-pending",
    "release:signoff:summary": "node ./tools/release-signoff-check.mjs --allow-pending --summary",
    "release:signoff:self-test": "node ./tools/release-signoff-self-test.mjs",
    "gaps:known": "node ./tools/known-gaps-check.mjs",
    "gaps:known:strict": "node ./tools/known-gaps-check.mjs --strict",
    "visual:smoke:css-local": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_VISUAL_REMOVE_CSS=tailwind.generated.css,template_styles.css,styles/global.css,styles/aiagents.css TACTICUM_VISUAL_INJECT_CSS=local/templates/tacticum/tailwind.generated.css,local/templates/tacticum/styles/global.css node ./tools/visual-smoke.mjs",
    "browser:smoke:css-local": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_VISUAL_REMOVE_CSS=tailwind.generated.css,template_styles.css,styles/global.css,styles/aiagents.css TACTICUM_VISUAL_INJECT_CSS=local/templates/tacticum/tailwind.generated.css,local/templates/tacticum/styles/global.css TACTICUM_VISUAL_ACTIONS=1 node ./tools/visual-smoke.mjs",
    "browser:console:css-local": "TACTICUM_VISUAL_BASE_URL=https://tacticum.ru TACTICUM_VISUAL_REMOVE_CSS=tailwind.generated.css,template_styles.css,styles/global.css,styles/aiagents.css TACTICUM_VISUAL_INJECT_CSS=local/templates/tacticum/tailwind.generated.css,local/templates/tacticum/styles/global.css TACTICUM_VISUAL_ACTIONS=1 TACTICUM_VISUAL_FAIL_ON_WARNINGS=1 node ./tools/visual-smoke.mjs",
    "config:check": "node ./tools/config-contract-check.mjs",
    "product:content:migrate": "php ./tools/product-content-migration.php",
    "product:content:migrate:apply": "php ./tools/product-content-migration.php --apply",
    "product:content:check": "php ./tools/product-content-check.php",
    "product:content:check:strict": "php ./tools/product-content-check.php --strict",
    "staff:sale:gate-helper": "node ./tools/staff-sale-gate-helper.mjs",
    "legacy:sale:inventory:logs": "node ./tools/legacy-sale-access-log-inventory.mjs",
    "sale:sunset:check": "node ./tools/legacy-sale-sunset-check.mjs",
    "bitrix:check": "node ./tools/bitrix-architecture-check.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.8",
    "tailwindcss": "4.1.8"
  }
}
